# BluHands — root env for the unified docker-compose (copy to .env, fill in).
# These feed ${...} interpolation in docker-compose.yml. Per-service secrets
# (control-plane DB/JWT) live in control-plane/.env.development.

# ── Agent ────────────────────────────────────────────────────────────────────
# 0 = build a lean agent image (base deps, dry-run) — fast, no OpenHands install.
# 1 = install the full OpenHands SDK stack for REAL builds (slower; uses uv).
INSTALL_AGENT=0
# Keep dry-run for a no-cost offline smoke test; set false for REAL builds.
AGENT_DRY_RUN=true
# 'local' (dev, no isolation) or 'e2b' (prod, isolated sandbox per build).
AGENT_SANDBOX_PROVIDER=local
# 'production' makes the agent REFUSE the unisolated local sandbox (safety guard).
AGENT_ENV=development
# E2B template with Node preinstalled (build it: agent/e2b/README.md).
AGENT_E2B_TEMPLATE=bluhands-node
# Max concurrent builds per agent replica (backpressure → 429 over this).
AGENT_MAX_CONCURRENT_BUILDS=4
# Required for real builds (LLM via OpenRouter) — never commit the real value.
OPENROUTER_API_KEY=
# Required when AGENT_SANDBOX_PROVIDER=e2b.
E2B_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the UI reaches the control-plane (through nginx on 8080 by default).
VITE_API_BASE_URL=http://localhost:8080
# Supabase project (user management / login). Anon key is public-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Ops ──────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
FLOWER_BASIC_AUTH=admin:changeme

# ── Self-hosted LLM (the Qwen box) ───────────────────────────────────────────
# Users whose email domain is in BLUHANDS_SELFHOSTED_DOMAINS are pinned to this
# endpoint. Also used by benchmark.py / benchmark.ps1 / get_models.ps1, which
# read the key from here instead of hardcoding it.
# Point BASE_URL at a host the app-server can actually REACH — an unreachable
# endpoint makes every agent step block until llm.timeout and then retry, which
# looks like the agent hanging on step 0 rather than like a network error.
BLUHANDS_SELFHOSTED_DOMAINS=trinetralabs.ai
BLUHANDS_SELFHOSTED_BASE_URL=http://122.160.253.37:8000/v1
BLUHANDS_SELFHOSTED_MODEL=openai/qwen3.6-35b-a3b
BLUHANDS_SELFHOSTED_API_KEY=

# Per-step output cap = a TIME budget: tokens / tokens-per-second must finish
# inside llm.timeout (300s). At the measured ~32 tok/s, 4096 => ~128s. Raise
# only if you benchmark the endpoint faster (python benchmark.py).
LLM_MAX_OUTPUT_TOKENS=4096

# ── Platform GitHub credentials (org-wide) ───────────────────────────────────
# Personal Access Token with `repo` scope on your organization. Must be a PAT --
# GitHub App installation tokens expire after 1 hour and are never refreshed here.
# Grafted onto every user's provider tokens so the repo picker and in-sandbox
# clone/push/PR work without each user connecting their own account — required
# for non-admin @<selfhosted-domain> users, whose Settings page is hidden.
# A token a user connected themselves always takes precedence over this.
BLUHANDS_GITHUB_TOKEN=
# Only for GitHub Enterprise; leave blank for github.com.
BLUHANDS_GITHUB_HOST=
