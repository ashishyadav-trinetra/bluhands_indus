# ─────────────────────────────────────────────────────────────────────────────
# OpenHands server — PRODUCTION environment
# Domain: app.bluhands.ai
#
# These are OpenHands-native env vars (no FORGE_ prefix).
# Deploy as: /home/ubuntu/openhands/.env  (or inject via systemd EnvironmentFile)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase pooler — pgbouncer compatible) ─────────────────────────
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.xkpeexoheupmvmyhiuyv
DB_PASS=<YOUR_DB_PASS>
DB_SSL=true

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# ❗ 401 AUTH LOOP FIX — read this carefully:
#
# The "aggressive reload / 401 loop" on login is caused by SUPABASE_JWT_SECRET
# not matching what Supabase actually signed the token with.
#
# FIX STEP 1: Go to Supabase dashboard → Settings → API → JWT Settings
#             Copy "JWT Secret" character-for-character (it looks like a
#             long base64 string, e.g. GUKkz...). No quotes, no newlines.
#
# FIX STEP 2: Make sure SUPABASE_ANON_KEY is the FULL anon JWT from the same
#             page (starts eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...).
#             A truncated or copy-paste-corrupted key will also cause 401 loops.
#
# FIX STEP 3: WEB_HOST must match the actual domain in the browser URL bar.
#             If users hit app.bluhands.ai but WEB_HOST is wrong, session
#             cookies get set on the wrong domain and every request is 401.
#
SUPABASE_URL=https://xkpeexoheupmvmyhiuyv.supabase.co
SUPABASE_ANON_KEY=<FULL_ANON_KEY_FROM_SUPABASE_DASHBOARD>
SUPABASE_JWT_SECRET=<JWT_SECRET_FROM_SUPABASE_DASHBOARD>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY_FROM_SUPABASE_DASHBOARD>

# ── Runtime ───────────────────────────────────────────────────────────────────
RUNTIME=process
SANDBOX_STARTUP_GRACE_SECONDS=60

# ── Web host ──────────────────────────────────────────────────────────────────
# CRITICAL: must exactly match the domain users access in the browser.
# This sets cookie domain, WebSocket origin, and MCP callback URL.
WEB_HOST=app.bluhands.ai

# ── Agent event persistence ───────────────────────────────────────────────────
# Subprocesses push conversation events here so agent memory survives restarts.
# On production: this must be reachable FROM the subprocesses on the same machine.
# Port 3000 is the OpenHands server itself — localhost:3000 IS correct here.
ENTERPRISE_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_BILLING=true
# SKIP_EMAIL_VERIFICATION is NOT set — email verification is enforced in prod

# ── Email (Resend — transactional) ───────────────────────────────────────────
RESEND_API_KEY=<RESEND_API_KEY>
FROM_EMAIL=noreply@bluhands.trinetralabs.ai

# ── Analytics ─────────────────────────────────────────────────────────────────
POSTHOG_CLIENT_KEY=phc_Ao6vKb7ENkKLmHtPVEUMdGr7ihBvWedCvLt9NSQB5FgQ

# ── Frontend static files ─────────────────────────────────────────────────────
FRONTEND_DIRECTORY=/home/ubuntu/openhands/frontend/build

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── Razorpay (subscription billing) ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_<YOUR_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>

# ── SSL / reverse proxy (when nginx terminates SSL) ───────────────────────────
# These tell OpenHands it's behind a proxy and should trust forwarded headers.
SERVE_FRONTEND=false          # nginx serves static files directly
TRUST_PROXY_HEADERS=true      # honour X-Forwarded-Proto so wss:// works
