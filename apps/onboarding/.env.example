# Onboarding app config — copy to .env.local and fill in values.
#
# Industry this deployment serves. One wizard codebase, many products:
#   ecommerce | crm | restaurant | erp | healthcare
NEXT_PUBLIC_INDUSTRY=ecommerce

# Mock mode (default): fully offline, no control plane needed.
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8080

# To go live (T-A03): set USE_MOCK_API=false and point at the nginx proxy.
# The control-plane must be running (docker compose up).
# NEXT_PUBLIC_USE_MOCK_API=false
# NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8080

# Supabase (required when USE_MOCK_API=false — used for login in AccountStep).
# Get these from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
