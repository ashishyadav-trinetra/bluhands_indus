# Medusa golden backend env (T-A02). Copy to .env. These are dev values — use a
# secrets manager in prod. Hostnames use the compose service names.

DATABASE_URL=postgres://medusa:medusa@medusa-db:5432/medusa
REDIS_URL=redis://medusa-redis:6379

# Dev secrets — REGENERATE for any real deployment.
JWT_SECRET=dev-jwt-secret-change-me
COOKIE_SECRET=dev-cookie-secret-change-me

# CORS: allow the storefront (T-A05) + admin. Comma-separated.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000

# India-centric defaults (UPI/Razorpay plugin config goes here once added).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
