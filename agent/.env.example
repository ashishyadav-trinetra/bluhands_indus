# ─────────────────────────────────────────────────────────────────────────────
# BluHands Agent — env template
# Copy to .env (gitignored). In production inject via Docker/systemd env.
# All vars use the AGENT_ prefix (pydantic-settings reads them automatically).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenRouter via LiteLLM) ─────────────────────────────────────────────
# Get your key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-<YOUR_KEY>
AGENT_LLM_MODEL=openrouter/anthropic/claude-sonnet-4.5

# ── Custom LLM (self-hosted OpenAI-compatible) ────────────────────────────────
# When both are configured, the model prefix selects the provider:
#   openrouter/...  → OpenRouter (default)
#   custom/...      → custom endpoint (e.g. api.bluehands.ai)
AGENT_CUSTOM_MODEL_ENABLED=false
# AGENT_CUSTOM_MODEL_BASE_URL=https://api.bluehands.ai/v1
# AGENT_CUSTOM_MODEL_API_KEY=anything

# ── Server ────────────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8100
AGENT_ENV=development           # development | production
                                # production refuses LocalSandbox; requires E2B.

# ── Build execution ───────────────────────────────────────────────────────────
AGENT_DRY_RUN=true              # true = no LLM, no network (dev/CI); false = real builds
AGENT_MAX_CONCURRENT_BUILDS=4

# ── Sandbox ───────────────────────────────────────────────────────────────────
# DEVELOPMENT:
AGENT_SANDBOX_PROVIDER=local    # local temp-dir, no isolation (dev only)

# PRODUCTION (switch to these):
# AGENT_SANDBOX_PROVIDER=e2b    # isolated ephemeral microVM per build
# E2B_API_KEY=e2b_...           # get from https://e2b.dev/dashboard
# AGENT_E2B_TEMPLATE=bluhands-node

# ── Preview URL ───────────────────────────────────────────────────────────────
# DEVELOPMENT — preview URL is http://127.0.0.1:{port}, only accessible locally.
#
# STAGING (local sandbox on a server) — set the server's public IP so the
# preview link is clickable from any browser:
#
#   AGENT_PREVIEW_PUBLIC_HOST=54.241.132.227
#
# Then open TCP ports 8011–8020 in your security group (one port per concurrent build).
# Preview URL becomes: http://54.241.132.227:{port}
#
# PRODUCTION — do NOT use LocalSandbox. Use E2B (AGENT_SANDBOX_PROVIDER=e2b above).
# E2B returns a unique public HTTPS URL automatically for each build.
# AGENT_PREVIEW_PUBLIC_HOST is not needed with E2B.
#
AGENT_PREVIEW_PUBLIC_HOST=      # leave empty for dev (localhost). Set server IP for staging.

# Workspace root — persisted by the named Docker volume (bluhands_builds).
AGENT_WORKSPACE_ROOT=/var/bluhands-builds

# ── Redis (durable job status — survives agent restarts) ─────────────────────
# Points at the control-plane's Redis container on the shared compose network.
AGENT_REDIS_URL=redis://cache:6379/1
