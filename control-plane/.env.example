# ─────────────────────────────────────────────────────────────────────────────
# Forge Control Plane — environment template.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# In production, inject these via your secrets manager (AWS Secrets Manager,
# Doppler, K8s secrets) — not a file.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
FORGE_ENV=development                  # development | staging | production
FORGE_DEBUG=true
FORGE_LOG_LEVEL=INFO                   # DEBUG|INFO|WARNING|ERROR|CRITICAL
FORGE_API_PREFIX=/api/v1

# --- CORS (exact origins, comma-separated; NEVER "*" in production) ---
FORGE_CORS_ORIGINS_CSV=http://localhost:3000

# --- Database (asyncpg DSN) ---
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@db:5432/forge
FORGE_DB_POOL_MIN_SIZE=5
FORGE_DB_POOL_MAX_SIZE=20

# --- Redis ---
FORGE_REDIS_URL=redis://cache:6379/0
FORGE_CELERY_BROKER_URL=redis://cache:6379/1
FORGE_CELERY_RESULT_BACKEND=redis://cache:6379/2

# --- JWT (RS256 asymmetric). Generate a keypair (see README). ---
# Provide PEM contents OR a file path. Keep the PRIVATE key secret.
FORGE_JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
FORGE_JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
FORGE_JWT_ISSUER=forge
FORGE_JWT_AUDIENCE=forge-clients
FORGE_ACCESS_TOKEN_TTL_SECONDS=900           # 15 minutes
FORGE_REFRESH_TOKEN_TTL_SECONDS=1209600      # 14 days

# --- Storage (S3-compatible) ---
FORGE_S3_ENDPOINT_URL=http://storage:9000
FORGE_S3_REGION=us-east-1
FORGE_S3_BUCKET=forge-artifacts
FORGE_S3_ACCESS_KEY_ID=CHANGE_ME
FORGE_S3_SECRET_ACCESS_KEY=CHANGE_ME
FORGE_S3_SIGNED_URL_TTL_SECONDS=900

# --- Supabase Auth (production platform identity) ---
FORGE_SUPABASE_URL=
FORGE_SUPABASE_JWKS_URL=
FORGE_SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (choose provider) ---
FORGE_PAYMENT_PROVIDER=stripe          # stripe | razorpay
FORGE_STRIPE_SECRET_KEY=
FORGE_STRIPE_WEBHOOK_SECRET=
FORGE_RAZORPAY_KEY_ID=
FORGE_RAZORPAY_KEY_SECRET=
FORGE_RAZORPAY_WEBHOOK_SECRET=

# --- Credits ---
FORGE_FREE_CREDITS_ON_SIGNUP=100
FORGE_BUILD_CREDIT_COST=10

# --- Rate limiting (per authenticated user defaults) ---
FORGE_RATE_LIMIT_DEFAULT_PER_MIN=100

# --- Observability ---
FORGE_SENTRY_DSN=
FORGE_PROMETHEUS_ENABLED=true
