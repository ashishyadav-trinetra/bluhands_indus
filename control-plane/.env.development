# Local development values — safe to share with the team (NO real secrets).
FORGE_ENV=development
FORGE_DEBUG=true
FORGE_LOG_LEVEL=DEBUG
FORGE_API_PREFIX=/api/v1
FORGE_CORS_ORIGINS_CSV=http://localhost:3000,http://localhost:3300

FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@db:5432/forge
FORGE_DB_POOL_MIN_SIZE=5
FORGE_DB_POOL_MAX_SIZE=20

FORGE_REDIS_URL=redis://cache:6379/0
FORGE_CELERY_BROKER_URL=redis://cache:6379/1
FORGE_CELERY_RESULT_BACKEND=redis://cache:6379/2

FORGE_JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
FORGE_JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
FORGE_JWT_ISSUER=forge
FORGE_JWT_AUDIENCE=forge-clients
FORGE_ACCESS_TOKEN_TTL_SECONDS=900
FORGE_REFRESH_TOKEN_TTL_SECONDS=1209600

FORGE_S3_ENDPOINT_URL=http://storage:9000
FORGE_S3_REGION=us-east-1
FORGE_S3_BUCKET=forge-artifacts
FORGE_S3_ACCESS_KEY_ID=minioadmin
FORGE_S3_SECRET_ACCESS_KEY=minioadmin
FORGE_S3_SIGNED_URL_TTL_SECONDS=900

FORGE_PAYMENT_PROVIDER=stripe
FORGE_FREE_CREDITS_ON_SIGNUP=100
FORGE_BUILD_CREDIT_COST=10
FORGE_RATE_LIMIT_DEFAULT_PER_MIN=100
FORGE_PROMETHEUS_ENABLED=true

# Self-hosted domain for automatic platform role promotion (Trinetra staff)
FORGE_SELFHOSTED_DOMAINS=trinetralabs.ai

# Supabase — required for Supabase-issued tokens to pass get_current_user.
# Get from: Supabase dashboard → Settings → API
#
# ℹ️  This Supabase project uses ES256 (asymmetric JWT signing).
#   Use FORGE_SUPABASE_JWKS_URL — it auto-fetches the public key and works for
#   both RS256 and ES256. FORGE_SUPABASE_JWT_SECRET is only for legacy HS256 projects.
#
FORGE_SUPABASE_URL=https://xkpeexoheupmvmyhiuyv.supabase.co
# FORGE_SUPABASE_JWT_SECRET — not needed: this project uses ES256 (asymmetric), use JWKS instead
FORGE_SUPABASE_JWT_AUDIENCE=authenticated
FORGE_SUPABASE_JWKS_URL=https://xkpeexoheupmvmyhiuyv.supabase.co/auth/v1/.well-known/jwks.json
FORGE_SUPABASE_SERVICE_ROLE_KEY= # eyJh... service role key from Supabase → Settings → API

# Agent mode — "http" wires the control-plane to the real agent container.
# Use "stub" for control-plane-only dev (no agent container running).
FORGE_AGENT_MODE=http
FORGE_AGENT_BASE_URL=http://agent:8100

# Nango — integration auth layer (https://app.nango.dev)
# Get the Secret Key from: Nango dashboard → Environment Settings → API Keys
# FORGE_NANGO_SECRET_KEY=nango_sk_...
# FORGE_NANGO_WEBHOOK_SECRET=          # optional — set in Nango Environment Settings
